<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ seo.title }}</title>
    <meta name="description" content="{{ seo.description }}" />
    <!-- The admin is unlisted by design (docs/security-model.md); the page is
         `private` so the SEO plugin skips it, hence the directive lives here. -->
    <meta name="robots" content="noindex,nofollow" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;500&family=Open+Sans:wght@300;500&display=swap"
    />
    <!-- The site's bundled styles are the base; admin-styles.css only adds the
         editor-specific styles on top. Vendored sheets load before admin-styles
         so the admin's own layer wins on equal-specificity collisions. -->
    <link rel="stylesheet" href="/assets/main.css" />
    <!-- Vendored EasyMDE, scoped to the Markdown overlay dialog. -->
    <link rel="stylesheet" href="/assets/js/easymde/easymde.min.css" />
    <link rel="stylesheet" href="/assets/css/admin-styles.css" />
    <!-- Vendored PrismJS theme for code blocks in the markdown preview. -->
    <link rel="stylesheet" href="/assets/js/prismjs/themes/prism-okaidia.css" />
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js" defer></script>
  </head>

  <body class="{{ bodyClass }}">
    {% include "components/sections/header/header.njk" %}

    {{ contents | safe }}

    {% include "components/sections/footer/footer.njk" %}

    <script type="importmap">
      {
        "imports": {
          "browser-fs-access": "/assets/js/browser-fs-access/index.modern.js"
        }
      }
    </script>

    <script>
      // Globals the editor expects on window. Hardcoded for POC (single locale, single author).
      window.APP_LOCALES = ['en'];
      window.DEFAULT_LOCALE = 'en';
      window.CURRENT_LOCALE = 'en';
      window.PATH_PREFIX = '/';
      window.AUTHORS = [{ name: 'Albert Einstein' }];
      window.BY_I18N = { en: 'by' };
    </script>

    <script>
      // Reveal the editor for signed-in Netlify Identity users; everyone else
      // gets a sign-in prompt. ?admin=true (or the localStorage flag it sets)
      // is a local-dev-only shortcut — Identity isn't proxied by plain dev
      // servers — and is ignored on the deployed site, where only a session
      // reveals the surface. Visibility is a courtesy either way — the
      // Functions are the security boundary (see docs/security-model.md).
      const isLocalDev =
        /^(localhost|127\.0\.0\.1|\[?::1\]?)$/.test(window.location.hostname) ||
        window.location.hostname.endsWith('.local');
      const urlParams = new URLSearchParams(window.location.search);
      const adminFromUrl = urlParams.get('admin') === 'true';
      const adminFromStorage = localStorage.getItem('admin') === 'true';

      if (adminFromUrl) {
        localStorage.setItem('admin', 'true');
      } else if (adminFromStorage) {
        urlParams.set('admin', 'true');
        window.location.search = urlParams.toString();
      }

      const isAdmin = isLocalDev && (adminFromUrl || adminFromStorage);

      // The editor ships inside an inert <template> and its modules are not
      // loaded statically: a signed-out visitor's page runs nothing but this
      // gate and the Identity widget. Revealing moves the template content
      // into the DOM, then boots the editor — in that order, because the
      // editor modules look their elements up at import time. The boot waits
      // for DOMContentLoaded so the deferred Identity widget script has run
      // before the editor wires it up.
      let editorBooted = false;
      const revealEditor = () => {
        const prompt = document.getElementById('admin-signin-prompt');
        if (prompt) prompt.style.display = 'none';
        if (editorBooted) return;
        editorBooted = true;
        const tpl = document.getElementById('admin-editor-template');
        if (tpl) tpl.parentNode.insertBefore(tpl.content, tpl);
        const boot = () => import('/assets/js/editor/create-post.js');
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', boot);
        } else {
          boot();
        }
      };

      if (isAdmin) {
        revealEditor();
      } else {
        // Clear the inline display:none the markup ships with (it prevents a
        // flash before this gate runs); the stylesheet owns the layout.
        const prompt = document.getElementById('admin-signin-prompt');
        if (prompt) prompt.style.removeProperty('display');

        // The widget script is deferred, so wire up after load. With the
        // editor dormant, this gate owns widget.init(): listeners first,
        // then init, so a cached session's 'init' event reveals the editor
        // on a return visit. (The editor's own initIdentity re-inits the
        // widget after boot; the widget tolerates that.)
        window.addEventListener('load', () => {
          const widget = window.netlifyIdentity;
          if (!widget) return;
          widget.on('init', (user) => {
            if (user) revealEditor();
          });
          widget.on('login', () => {
            widget.close();
            revealEditor();
          });
          const btn = document.getElementById('admin-signin-prompt-btn');
          if (btn) btn.onclick = () => widget.open('login');
          widget.init();
        });
      }
    </script>

    <script src="/assets/js/marked/marked.umd.js"></script>
    <script src="/assets/js/prismjs/prism.js"></script>
    <script src="/assets/js/turndown/turndown.js"></script>
    <script src="/assets/js/jszip/jszip.js"></script>
    <script src="/assets/js/js-yaml/js-yaml.min.js"></script>
    <script src="/assets/js/easymde/easymde.min.js"></script>

    <!-- Shared site chrome (header/footer) interactivity. SWUP self-disables on
         the admin body class, so this does not add page transitions here. -->
    <script src="/assets/main.js"></script>

    <!-- No static editor script: the reveal gate above dynamic-imports
         create-post.js only once a session exists (or on localhost). -->
  </body>
</html>
